# ── MediBot configuration ─────────────────────────────────────────────────────
# Copy this file to `.env` and fill in ONE of the two API keys below.
#
#   cp .env.example .env
#
# Without a key the app still starts, but it can only quote passages from the
# local knowledge base — it cannot generate an AI answer. The UI shows an
# "offline" badge and a banner when that happens, so you are never left
# guessing why the replies look generic.

# ── Option 1: OpenRouter (has a free tier) ────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional — any model id OpenRouter serves.
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# ── Option 2: Groq (free, fast) ───────────────────────────────────────────────
# Get a key at https://console.groq.com
# Also used as the automatic fallback if the OpenRouter call fails.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
